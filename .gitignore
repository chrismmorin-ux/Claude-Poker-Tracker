# Screenshots (debug artifacts)
screenshots/
*.png
!public/*.png
# Audit evidence is tracked content, not debug output (LSW surface audits, etc.)
!docs/design/audits/**/*.png
# Playwright snapshot baselines ARE tracked (visual regression source-of-truth)
!tests/playwright/**/*.png
audit-*.png
verify-*.png
.local-model-backups/
.claude/logs/*.log
.playwright-mcp/
# Playwright test artifacts (per-run output; not the baselines)
tests/playwright/.test-results/
playwright-report/
test-results/
.firebase

# Ignition poker tracker — build artifacts and deps only
ignition-poker-tracker/node_modules/
ignition-poker-tracker/dist/

# Personal notes
docs/chris-notes
.playwright-verify/

.cwos-snapshots/

# Python bytecode (scripts/backtest/*.py)
__pycache__/
*.pyc

# Backtest harness output artifacts (scripts/backtest/run.mjs --out, mined tables)
out/

# /kit-upgrade sidecars — upstream's version of a file we've customized, written
# alongside it for hand review. Working artifacts, never part of the tree.
*.kit-update

# ── CWOS (managed block — ADR-058) ──────────────────────────────────────
# Workstream state JSON is a per-node rebuildable cache: it is rewritten
# wholesale on every event and cannot merge across machines. It rebuilds
# automatically from your queue/findings/sprints/programs files, so it
# never needs to be in version control. findings-feedback-manifest.json
# is calibration data, not cache — it stays tracked.
.claude/workstream/state/*.json
!.claude/workstream/state/findings-feedback-manifest.json
.claude/workstream/state/*.lock
# The event log is machine-local by design (ADR-057/ADR-058).
.claude/workstream/events/
.claude/workstream/telemetry/
.claude/workstream/tmp/
.claude/.tmp-*.json
.cwos-snapshots/
