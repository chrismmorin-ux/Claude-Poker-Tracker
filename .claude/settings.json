{
  "permissions": {
    "allow": [
      "Edit(**)",
      "Write(**)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(node:*)",
      "Bash(bash:*)",
      "Bash(git:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(gh:*)",
      "Bash(cat:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(wc:*)",
      "Bash(./scripts/*:*)",
      "Bash(bash scripts/*:*)",
      "WebSearch",
      "WebFetch(domain:*)",
      "SlashCommand(**)",
      "Task(**)",
      "Glob(**)",
      "Grep(**)",
      "Read(**)"
    ],
    "ask": [
      "ExitPlanMode"
    ],
    "deny": []
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/context-barrier.cjs"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/git-guard.cjs"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/secrets-scan.cjs"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/pre-commit-gate.cjs"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/readiness-gate.cjs"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/context-bundle-check.cjs"
          },
          {
            "type": "command",
            "command": "node kit/scripts/cwos-session-register.js"
          },
          {
            "type": "command",
            "command": "node kit/scripts/cwos-session-vitals.js"
          },
          {
            "type": "command",
            "command": "node scripts/check-deploy-freshness.mjs --quiet"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node kit/scripts/cwos-heartbeat.js"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/session-heartbeat.cjs"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/retreat-detector.cjs"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/improvement-default.cjs"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/compact-tier.cjs"
          }
        ]
      }
    ]
  }
}
