# ---------------------------------------------------------------------------
# LOCAL DEVELOPMENT WITHOUT A FIREBASE PROJECT
#
# You do NOT need real Firebase credentials to run, screenshot, or visually
# verify this app. Run:
#
#     npm run env:local     # writes a .env.local of placeholders
#     npm run dev
#     npm run devshot       # drives a real browser, captures screenshots,
#                           # and measures RENDERED control sizes
#
# The app is IndexedDB-first with an existing guest mode, so the full local
# feature set works. Only sign-in / sync require a real project (below).
# ---------------------------------------------------------------------------

# Firebase Configuration
# Copy this file to .env.local and fill in your values
# Get these from Firebase Console > Project Settings > Your apps
#
# IMPORTANT: Never commit .env.local to git (it's in .gitignore)

VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef123456
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# PostHog Telemetry (MPMF G5-B2)
# Leave empty for silent-mode telemetry (events go to console.debug only).
# Set this to your PostHog project key to enable live event capture.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
